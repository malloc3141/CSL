# Copy to .env and fill in. Every value here is optional except the OpenRouter ones when PIPELINE != mock.

# Which pipeline drives the agents:
#   mock      scripted "Why is summer hotter than winter?" scenario, no LLM calls
#   baseline  simple reference pipeline on OpenRouter
#   pkg.module:ClassName   your own Pipeline implementation (see docs/PIPELINE.md)
PIPELINE=mock

OPENROUTER_API_KEY=
# Pick model ids from https://openrouter.ai/models
OPENROUTER_MODEL=
# Cheaper model for speaker selection / state updates. Falls back to OPENROUTER_MODEL.
OPENROUTER_MODEL_FAST=
# Model "thinking": off (default) | low | medium | high | default. Thinking tokens count against
# each call's max_tokens; with thinking on, short replies can come back empty.
LLM_REASONING=off

# Frontend origins allowed to call the API and open the WebSocket (comma separated).
# In production set this to the public origin, e.g. https://csl.example.com
CORS_ORIGINS=http://localhost:3000

# If set, POST /api/sessions requires this code. Keeps strangers from spending the API budget.
ACCESS_CODE=
# If set, enables GET /api/admin/* with "Authorization: Bearer <token>" (event log export).
ADMIN_TOKEN=

DATABASE_PATH=data/csl.db
MAX_TURNS=60
MAX_ACTIVE_SESSIONS=20
